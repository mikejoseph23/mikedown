{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "types": ["vite/client"],
    "paths": {
      "@mikedown/core": ["../core/dist/index.d.ts"],
      "@mikedown/core/shared/*": ["../core/src/shared/*"]
    }
  },
  "include": ["src"]
}
