<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
  <location path="latest.json">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, max-age=0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="latest-darwin-aarch64.json">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, max-age=0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="latest-darwin-x86_64.json">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, max-age=0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="latest-windows-x86_64.json">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, max-age=0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
