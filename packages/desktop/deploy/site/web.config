<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lives in the iadev.net/mikedown/ IIS folder (the /mikedown virtual directory
  under site Interapp). release.sh stages it with every release; MERGE it into
  the live copy rather than overwriting once the folder has its own settings.

  - CORS: the manifest and artifacts are public, so any origin may read
    latest.json (the download page is same-origin; this is for other pages).
  - latest.json must never be cached by browsers or Cloudflare's edge rules
    beyond what a purge clears; versioned artifacts are immutable.
  - MIME maps: .sig (updater signatures) is unmapped in IIS by default. Do NOT
    add a mimeMap for an extension the site already maps (.json, .dmg, .exe):
    a duplicate entry is a 500. .gz (the macOS updater .app.tar.gz) is mapped
    in recent IIS defaults; if https://www.iadev.net/mikedown/<file>.app.tar.gz
    answers 404, uncomment the .gz line below.
-->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <mimeMap fileExtension=".sig" mimeType="text/plain" />
      <!-- <mimeMap fileExtension=".gz" mimeType="application/gzip" /> -->
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
  <location path="latest.json">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, max-age=0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
