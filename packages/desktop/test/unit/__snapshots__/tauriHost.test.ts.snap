// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`TauriHost invoke traffic > an editor change marks dirty, and the pristine text clears it 1`] = `
[
  {
    "args": {
      "edited": true,
    },
    "cmd": "set_document_edited",
  },
  {
    "args": {
      "edited": false,
    },
    "cmd": "set_document_edited",
  },
]
`;

exports[`TauriHost invoke traffic > openLink: external goes to the shell plugin, a local link reads the file, an anchor stays in the editor 1`] = `
[
  {
    "args": {
      "path": "https://example.com/a?b=1",
    },
    "cmd": "plugin:shell|open",
  },
  {
    "args": {
      "path": "/Users/mike/notes/other.md",
    },
    "cmd": "stat",
  },
  {
    "args": {
      "path": "/Users/mike/notes/other.md",
    },
    "cmd": "read_text",
  },
  {
    "args": {
      "label": "main",
      "value": "other.md — notes",
    },
    "cmd": "plugin:window|set_title",
  },
  {
    "args": {
      "path": "/Users/mike/notes/other.md",
    },
    "cmd": "set_represented_file",
  },
]
`;

