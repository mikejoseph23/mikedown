exports[`TauriHost invoke traffic > pickImage inside the document folder only widens the asset scope 1`] = `
[
  {
    "args": {
      "options": {
        "defaultPath": "/Users/mike/notes",
        "directory": false,
        "filters": [
          {
            "extensions": [
              "png",
              "jpg",
              "jpeg",
              "gif",
              "webp",
              "svg",
              "bmp",
              "avif",
            ],
            "name": "Images",
          },
        ],
        "multiple": false,
        "title": "Insert Image",
      },
    },
    "cmd": "plugin:dialog|open",
  },
  {
    "args": {
      "path": "/Users/mike/notes/pics/a.png",
    },
    "cmd": "allow_asset",
  },
]
`;

exports[`TauriHost invoke traffic > pickImage outside the document folder copies the file in 1`] = `
[
  {
    "args": {
      "options": {
        "defaultPath": "/Users/mike/notes",
        "directory": false,
        "filters": [
          {
            "extensions": [
              "png",
              "jpg",
              "jpeg",
              "gif",
              "webp",
              "svg",
              "bmp",
              "avif",
            ],
            "name": "Images",
          },
        ],
        "multiple": false,
        "title": "Insert Image",
      },
    },
    "cmd": "plugin:dialog|open",
  },
  {
    "args": {
      "path": "/Users/mike/Downloads/shot.png",
    },
    "cmd": "read_bytes",
  },
  {
    "args": {
      "path": "/Users/mike/notes/images",
    },
    "cmd": "list_dir",
  },
  {
    "args": {
      "path": "/Users/mike/notes/images",
    },
    "cmd": "mkdir",
  },
  {
    "args": {
      "bytes": [
        137,
        80,
        78,
        71,
        1,
        2,
        3,
      ],
    },
    "cmd": "write_bytes",
    "headers": {
      "x-path": "%2FUsers%2Fmike%2Fnotes%2Fimages%2Ftodo-20261023-140509.png",
    },
  },
]
`;

