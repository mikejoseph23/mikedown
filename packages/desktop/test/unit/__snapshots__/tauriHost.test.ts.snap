exports[`TauriHost invoke traffic > save writes the document with its own line ending and BOM options 1`] = `
[
  {
    "args": {
      "edited": true,
    },
    "cmd": "set_document_edited",
  },
  {
    "args": {
      "path": "/Users/mike/notes/todo.md",
    },
    "cmd": "stat",
  },
  {
    "args": {
      "options": {
        "bom": false,
        "eol": "lf",
      },
      "path": "/Users/mike/notes/todo.md",
      "text": "# Todo

edited
",
    },
    "cmd": "write_text",
  },
  {
    "args": {
      "edited": false,
    },
    "cmd": "set_document_edited",
  },
]
`;

