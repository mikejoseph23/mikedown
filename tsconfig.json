{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "out",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@mikedown/core/shared/*": ["packages/core/src/shared/*"],
      "@mikedown/core/ai": ["packages/core/src/ai/index.ts"]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "packages/core/src/shared/**/*", "packages/core/src/ai/**/*"],
  "exclude": ["node_modules", "out", "dist", "src/webview"]
}
